import random
import time
import os

sobreviventes = []

inventario = {
    "Comida": 5,
    "Agua": 5,
    "Madeira": 3,
    "Pedra": 2,
    "Metal": 1,
    "Medicamento": 1,
    "Tecido": 2,
    "Municao": 3
}

construcoes = []

vida = 100
fome = 100
sede = 100
energia = 100
dia = 1


def limpar():
    os.system("cls" if os.name == "nt" else "clear")


def esperar():
    input("\nPressione ENTER para continuar...")


def cadastrar():
    limpar()

    print("================================")
    print("      CADASTRO DE SOBREVIVENTE")
    print("================================")

    nome = input("Nome: ")

    while True:
        idade = input("Idade: ")

        if idade.isdigit():
            idade = int(idade)
            break

        print("Digite uma idade válida.")

    print("\nEscolha uma habilidade:")
    print("1 - Médico")
    print("2 - Explorador")
    print("3 - Engenheiro")
    print("4 - Soldado")

    escolha = input("Escolha: ")

    if escolha == "1":
        habilidade = "Médico"
    elif escolha == "2":
        habilidade = "Explorador"
    elif escolha == "3":
        habilidade = "Engenheiro"
    elif escolha == "4":
        habilidade = "Soldado"
    else:
        habilidade = "Sobrevivente"

    pessoa = {
        "nome": nome,
        "idade": idade,
        "habilidade": habilidade,
        "vida": 100
    }

    sobreviventes.append(pessoa)

    print("\nSobrevivente cadastrado!")
    esperar()


def ver_sobreviventes():
    limpar()

    print("================================")
    print("         SOBREVIVENTES")
    print("================================")

    if len(sobreviventes) == 0:
        print("Nenhum sobrevivente cadastrado.")
    else:
        for numero, pessoa in enumerate(sobreviventes, 1):
            print("\nSobrevivente", numero)
            print("Nome:", pessoa["nome"])
            print("Idade:", pessoa["idade"])
            print("Habilidade:", pessoa["habilidade"])
            print("Vida:", pessoa["vida"])

    esperar()


def inventario():
    limpar()

    print("================================")
    print("           INVENTÁRIO")
    print("================================")

    for item, quantidade in inventario_atual.items():
        print(item + ":", quantidade)

    esperar()


def coletar():
    global energia, fome, sede

    limpar()

    print("================================")
    print("        COLETA DE RECURSOS")
    print("================================")

    if energia < 10:
        print("Você está cansado demais para coletar recursos.")
        esperar()
        return

    print("Você saiu para procurar recursos...")
    time.sleep(1)

    energia -= 10
    fome -= 5
    sede -= 5

    recurso = random.choice([
        "Madeira",
        "Pedra",
        "Metal",
        "Comida",
        "Agua",
        "Tecido"
    ])

    quantidade = random.randint(1, 4)

    inventario_atual[recurso] += quantidade

    print("\nVocê encontrou:")
    print(quantidade, recurso)

    chance = random.randint(1, 100)

    if chance <= 25:
        dano = random.randint(5, 15)
        vida_atual[0] -= dano

        print("\nUm zumbi apareceu!")
        print("Você perdeu", dano, "de vida.")

    elif chance <= 40:
        inventario_atual["Medicamento"] += 1
        print("\nVocê encontrou um medicamento.")

    esperar()


def construir():
    limpar()

    print("================================")
    print("           CONSTRUÇÃO")
    print("================================")

    print("1 - Fogueira")
    print("   5 Madeira + 2 Pedra")

    print("\n2 - Barricada")
    print("   8 Madeira + 3 Metal")

    print("\n3 - Kit médico")
    print("   2 Medicamento + 1 Tecido")

    print("\n4 - Arma")
    print("   5 Metal + 2 Madeira")

    print("\n5 - Voltar")

    escolha = input("\nEscolha: ")

    if escolha == "1":
        if inventario_atual["Madeira"] >= 5 and inventario_atual["Pedra"] >= 2:
            inventario_atual["Madeira"] -= 5
            inventario_atual["Pedra"] -= 2
            construcoes.append("Fogueira")
            print("\nFogueira construída!")
        else:
            print("\nVocê não possui materiais suficientes.")

    elif escolha == "2":
        if inventario_atual["Madeira"] >= 8 and inventario_atual["Metal"] >= 3:
            inventario_atual["Madeira"] -= 8
            inventario_atual["Metal"] -= 3
            construcoes.append("Barricada")
            print("\nBarricada construída!")
        else:
            print("\nVocê não possui materiais suficientes.")

    elif escolha == "3":
        if inventario_atual["Medicamento"] >= 2 and inventario_atual["Tecido"] >= 1:
            inventario_atual["Medicamento"] -= 2
            inventario_atual["Tecido"] -= 1

            if "Kit Medico" not in inventario_atual:
                inventario_atual["Kit Medico"] = 0

            inventario_atual["Kit Medico"] += 1

            print("\nKit médico construído!")
        else:
            print("\nVocê não possui materiais suficientes.")

    elif escolha == "4":
        if inventario_atual["Metal"] >= 5 and inventario_atual["Madeira"] >= 2:
            inventario_atual["Metal"] -= 5
            inventario_atual["Madeira"] -= 2
            inventario_atual["Municao"] += 2
            construcoes.append("Arma")
            print("\nArma construída!")
            print("Você recebeu 2 munições.")
        else:
            print("\nVocê não possui materiais suficientes.")

    elif escolha == "5":
        return

    else:
        print("\nOpção inválida.")

    esperar()


def usar_item():
    global fome, sede

    limpar()

    print("================================")
    print("           USAR ITEM")
    print("================================")

    print("1 - Comer")
    print("2 - Beber água")
    print("3 - Usar medicamento")
    print("4 - Usar kit médico")
    print("5 - Voltar")

    escolha = input("\nEscolha: ")

    if escolha == "1":
        if inventario_atual["Comida"] > 0:
            inventario_atual["Comida"] -= 1
            fome += 25

            if fome > 100:
                fome = 100

            print("\nVocê comeu.")
        else:
            print("\nVocê não possui comida.")

    elif escolha == "2":
        if inventario_atual["Agua"] > 0:
            inventario_atual["Agua"] -= 1
            sede += 30

            if sede > 100:
                sede = 100

            print("\nVocê bebeu água.")
        else:
            print("\nVocê não possui água.")

    elif escolha == "3":
        if inventario_atual["Medicamento"] > 0:
            inventario_atual["Medicamento"] -= 1

            vida_atual[0] += 20

            if vida_atual[0] > 100:
                vida_atual[0] = 100

            print("\nVocê utilizou um medicamento.")
        else:
            print("\nVocê não possui medicamento.")

    elif escolha == "4":
        if inventario_atual.get("Kit Medico", 0) > 0:
            inventario_atual["Kit Medico"] -= 1

            vida_atual[0] += 40

            if vida_atual[0] > 100:
                vida_atual[0] = 100

            print("\nVocê utilizou um kit médico.")
        else:
            print("\nVocê não possui kit médico.")

    elif escolha == "5":
        return

    else:
        print("\nOpção inválida.")

    esperar()


def explorar():
    global energia, fome, sede

    limpar()

    print("================================")
    print("           EXPLORAÇÃO")
    print("================================")

    print("1 - Mercado")
    print("2 - Hospital")
    print("3 - Delegacia")
    print("4 - Bairro")
    print("5 - Fábrica")
    print("6 - Voltar")

    escolha = input("\nEscolha o local: ")

    locais = {
        "1": "Mercado",
        "2": "Hospital",
        "3": "Delegacia",
        "4": "Bairro",
        "5": "Fábrica"
    }

    if escolha == "6":
        return

    if escolha not in locais:
        print("\nLocal inválido.")
        esperar()
        return

    local = locais[escolha]

    print("\nVocê está explorando:", local)
    time.sleep(1)

    energia -= 15
    fome -= 8
    sede -= 10

    acontecimento = random.randint(1, 100)

    if acontecimento <= 30:

        zumbis = random.randint(1, 3)

        print("\nVocê encontrou", zumbis, "zumbis!")

        if inventario_atual["Municao"] > 0:

            inventario_atual["Municao"] -= 1

            dano = random.randint(5, 15)
            vida_atual[0] -= dano

            print("Você conseguiu escapar.")
            print("Perdeu", dano, "de vida.")

        else:

            dano = random.randint(10, 25)
            vida_atual[0] -= dano

            print("Você está sem munição!")
            print("Perdeu", dano, "de vida.")

    elif acontecimento <= 75:

        recurso = random.choice([
            "Comida",
            "Agua",
            "Madeira",
            "Pedra",
            "Metal",
            "Tecido"
        ])

        quantidade = random.randint(1, 4)

        inventario_atual[recurso] += quantidade

        print("\nVocê encontrou:")
        print(quantidade, recurso)

    else:

        print("\nVocê encontrou uma pista.")

        if local == "Hospital":
            print("Os documentos falam sobre o início da infecção.")

        elif local == "Delegacia":
            print("Uma gravação fala sobre o isolamento da cidade.")

        elif local == "Mercado":
            print("Uma mensagem fala sobre uma torre de rádio.")

        elif local == "Fábrica":
            print("Você encontrou materiais que podem ajudar na construção.")

        else:
            print("Você encontrou uma mensagem pedindo ajuda.")

    esperar()


def descansar():
    global energia, fome, sede, dia

    limpar()

    print("================================")
    print("            DESCANSO")
    print("================================")

    energia += 40
    fome -= 10
    sede -= 10
    dia += 1

    if energia > 100:
        energia = 100

    print("Você descansou.")
    print("Um novo dia começou.")
    print("Dia:", dia)

    esperar()


def mostrar_status():
    limpar()

    print("================================")
    print("             STATUS")
    print("================================")

    print("Vida:", vida_atual[0])
    print("Fome:", fome)
    print("Sede:", sede)
    print("Energia:", energia)
    print("Dia:", dia)

    print("\nConstruções:")

    if len(construcoes) == 0:
        print("Nenhuma construção.")
    else:
        for item in construcoes:
            print("-", item)

    esperar()


def verificar_estado():
    global fome, sede

    if fome < 0:
        fome = 0

    if sede < 0:
        sede = 0

    if energia < 0:
        energia = 0

    if fome == 0:
        vida_atual[0] -= 10
        print("\nVocê está com muita fome!")

    if sede == 0:
        vida_atual[0] -= 10
        print("Você está com muita sede!")


def iniciar_jogo():

    while True:

        verificar_estado()

        if vida_atual[0] <= 0:
            limpar()

            print("================================")
            print("           FIM DE JOGO")
            print("================================")
            print("Você não conseguiu sobreviver.")

            break

        limpar()

        print("================================")
        print("        ÚLTIMA TRANSMISSÃO")
        print("================================")

        print("Uma cidade foi tomada por zumbis.")
        print("Sobreviva e descubra o que aconteceu.")

        print("\nVida:", vida_atual[0])
        print("Fome:", fome)
        print("Sede:", sede)
        print("Energia:", energia)
        print("Dia:", dia)

        print("\n1 - Cadastrar sobrevivente")
        print("2 - Coletar recursos")
        print("3 - Ver inventário")
        print("4 - Construir")
        print("5 - Explorar cidade")
        print("6 - Usar item")
        print("7 - Descansar")
        print("8 - Ver sobreviventes")
        print("9 - Ver status")
        print("0 - Sair")

        escolha = input("\nEscolha: ")

        if escolha == "1":
            cadastrar()

        elif escolha == "2":
            coletar()

        elif escolha == "3":
            inventario()

        elif escolha == "4":
            construir()

        elif escolha == "5":
            explorar()

        elif escolha == "6":
            usar_item()

        elif escolha == "7":
            descansar()

        elif escolha == "8":
            ver_sobreviventes()

        elif escolha == "9":
            mostrar_status()

        elif escolha == "0":
            print("\nJogo encerrado.")
            break

        else:
            print("\nOpção inválida.")
            esperar()


inventario_atual = {
    "Comida": 5,
    "Agua": 5,
    "Madeira": 3,
    "Pedra": 2,
    "Metal": 1,
    "Medicamento": 1,
    "Tecido": 2,
    "Municao": 3
}

vida_atual = [100]

iniciar_jogo()
